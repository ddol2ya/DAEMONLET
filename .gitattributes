# Preserve the downloaded official legal code byte for byte on every platform.
/distribution/licenses/CC-BY-4.0.txt -text whitespace=-blank-at-eof
# The pack includes the complete legal code, including its trailing blank lines.
/public/characters/gpichan/LICENSE.txt whitespace=-blank-at-eof
# Hash these selected text artwork files consistently across checkouts.
/electron/assets/trayTemplate.svg text eol=lf
/public/favicon.svg text eol=lf
# Runtime catalogs pin the exact legal-notice bytes on both build hosts.
/distribution/licenses/character-chat/* -text whitespace=cr-at-eol,-blank-at-eof
/electron/native/character-chat/* text eol=lf
# New Windows voice receipts use LF lock bytes, independent of core.autocrlf.
/electron/voice/install-windows-base.json text eol=lf
# Vendor legal text includes intentional original spaces; do not rewrite it.
/distribution/licenses/character-chat/CUDA-13.0-EULA.txt whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
# These bytes are hashed by both managed GGUF worker policies. Preserve the
# committed bytes even when a Windows checkout enables core.autocrlf.
electron/voice/managed-gguf-runtime-catalog.json -text
electron/voice/runtime-qwen-gguf-windows.json -text
electron/voice/runtime-gguf-windows-voxcpm2.json -text
# The default-voice policy pins this JSON's exact bytes as well.
electron/voice/base-voice-defaults.json -text
# Runtime terms retain their upstream bytes, including original formatting.
electron/voice/runtime-terms/* -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
electron/voice/managed-runtime-terms.json -text
