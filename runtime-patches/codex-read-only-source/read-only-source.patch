+#[test]
+fn completed_prefix_excludes_newer_input_and_partial_record_without_writes() {
+    let f = Fixture::new();
+    f.write(vec![
+        f.header(None),
+        marker(1, "SELECTED"),
+        f.complete(2),
+        marker(3, "IN_PROGRESS"),
+    ]);
+    OpenOptions::new()
+        .append(true)
+        .open(&f.path)
+        .unwrap()
+        .write_all(b"{unfinished")
+        .unwrap();
+    let before = fs::read(&f.path).unwrap();
+    let result = f.run().unwrap();
+    let history = serde_json::to_string(&result.prepared.model_context).unwrap();
+    assert!(history.contains("SELECTED"));
+    assert!(!history.contains("IN_PROGRESS"));
+    assert_eq!(result.snapshot.terminal_turn_id, f.turn.to_string());
+    assert_eq!(result.snapshot.end_ordinal_exclusive, 3);
+    assert_eq!(
+        &before[result.snapshot.end_byte_offset as usize..][..1],
+        b"{"
+    );
+    assert_eq!(fs::read(&f.path).unwrap(), before);
+    assert_eq!(fs::read_dir(f.home.path()).unwrap().count(), 1);
+}
