+    fn header(&self, base: Option<HistoryPosition>) -> Value {
+        let meta = SessionMeta {
+            id: self.id,
+            session_id: self.id.into(),
+            timestamp: AT.into(),
+            history_mode: ThreadHistoryMode::Paginated,
+            history_base: base,
+            cwd: self.home.path().into(),
+            ..Default::default()
+        };
+        json!({"timestamp":AT,"ordinal":base.map_or(0, |p| p.end_ordinal_exclusive),"type":"session_meta","payload":meta})
+    }
+    fn write(&self, lines: Vec<Value>) {
+        let mut file = File::create(&self.path).unwrap();
+        for line in lines {
+            writeln!(file, "{line}").unwrap();
+        }
+    }
+    fn complete(&self, ordinal: u64) -> Value {
+        json!({"timestamp":AT,"ordinal":ordinal,"type":"event_msg","payload":{"type":"task_complete","turn_id":self.turn.to_string(),"last_agent_message":null}})
+    }
+    fn run(&self) -> Result<ReadOnlyPrepared, String> {
+        read(
+            ReadOnlyForkSourceParams {
+                source_home: AbsolutePathBuf::try_from(fs::canonicalize(self.home.path()).unwrap())
+                    .unwrap(),
+                source_identity: identity(&fs::metadata(&self.path).unwrap()),
+            },
+            self.path.clone(),
+            self.id,
+            Arc::new(AtomicBool::new(false)),
+        )
+    }
