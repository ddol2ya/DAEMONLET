@@ -0,0 +1,33 @@
+//! An ephemeral fork source that never constructs a writable source store.
+use codex_app_server_protocol::ReadOnlyForkSnapshot;
+use codex_app_server_protocol::ReadOnlyForkSourceParams;
+use codex_protocol::ThreadId;
+use codex_thread_store::PreparedFork;
+use codex_thread_store::StoredThread;
+use std::path::PathBuf;
+
+pub(crate) struct ReadOnlyPrepared {
+    pub(crate) source: StoredThread,
+    pub(crate) prepared: PreparedFork,
+    pub(crate) snapshot: ReadOnlyForkSnapshot,
+}
+
+#[cfg(target_os = "macos")]
+#[path = "read_only_source_macos.rs"]
+mod platform;
+
+pub(crate) async fn prepare(
+    selector: ReadOnlyForkSourceParams,
+    path: PathBuf,
+    thread_id: ThreadId,
+) -> Result<ReadOnlyPrepared, String> {
+    #[cfg(target_os = "macos")]
+    {
+        platform::prepare(selector, path, thread_id).await
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        let _ = (selector, path, thread_id);
+        Err("SOURCE_PLATFORM_UNSUPPORTED".to_string())
+    }
+}
