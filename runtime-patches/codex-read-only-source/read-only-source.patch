@@ -0,0 +1,509 @@
+use super::*;
+use chrono::DateTime;
+use chrono::Utc;
+use codex_protocol::models::PermissionProfile;
+use codex_protocol::protocol::AskForApproval;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::HistoryPosition;
+use codex_protocol::protocol::SessionMetaLine;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_rollout::ModelContextScan;
+use codex_rollout::ModelContextScanProgress;
+use codex_rollout::ReverseJsonlScanner;
+use codex_rollout::RolloutItem;
+use codex_rollout::ScanOutcome;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::HashSet;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::fs::{self};
+use std::io::BufRead;
+use std::io::BufReader;
+use std::io::Cursor;
+use std::io::Read;
+use std::os::unix::fs::FileExt;
+use std::os::unix::fs::MetadataExt;
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+
+const SCAN_BYTES: usize = 64 * 1024 * 1024;
+const CONTEXT_BYTES: usize = 16 * 1024 * 1024;
+const RECORD_BYTES: usize = 2 * 1024 * 1024;
+const SOURCE_FILES: usize = 8;
+const RECORDS: usize = 100_000;
+// Darwin <sys/fcntl.h>. This module is deliberately not compiled for other OSes.
+const DARWIN_O_NOFOLLOW: i32 = 0x0100;
+static READERS: OnceLock<Arc<tokio::sync::Semaphore>> = OnceLock::new();
+struct Cancel(Arc<AtomicBool>);
+impl Drop for Cancel {
+    fn drop(&mut self) {
+        self.0.store(true, Ordering::Release);
+    }
+}
+struct Budget {
+    start: Instant,
+    cancelled: Arc<AtomicBool>,
+    bytes: usize,
+    records: usize,
+    context: usize,
+}
+impl Budget {
+    fn check(&self) -> Result<(), String> {
+        if self.cancelled.load(Ordering::Acquire) {
+            return Err("SOURCE_CANCELLED".into());
+        }
+        if self.start.elapsed() > Duration::from_secs(15) {
+            return Err("SOURCE_TIMEOUT".into());
+        }
+        Ok(())
+    }
+}
+struct Window {
+    file: File,
+    path: PathBuf,
+    identity: String,
+    start: u64,
+    bytes: Vec<u8>,
+    head: Vec<u8>,
+    meta: SessionMetaLine,
+    rollout_id: ThreadId,
+}
+
+pub(super) async fn prepare(
+    selector: ReadOnlyForkSourceParams,
+    path: PathBuf,
+    thread_id: ThreadId,
+) -> Result<ReadOnlyPrepared, String> {
+    let permit = READERS
+        .get_or_init(|| Arc::new(tokio::sync::Semaphore::new(1)))
+        .clone()
+        .try_acquire_owned()
+        .map_err(|_| "SOURCE_BUSY")?;
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let _cancel = Cancel(Arc::clone(&cancelled));
+    tokio::task::spawn_blocking(move || {
+        let _permit = permit;
+        read(selector, path, thread_id, cancelled)
+    })
+    .await
+    .map_err(|_| "SOURCE_READER_FAILED".to_string())?
+}
+
+fn identity(meta: &fs::Metadata) -> String {
+    format!("{}:{}", meta.dev(), meta.ino())
+}
+fn secure_file(root: &Path, path: &Path) -> Result<(File, String), String> {
+    let canonical = fs::canonicalize(path).map_err(|_| "SOURCE_ACCESS")?;
+    if canonical != path
+        || !["sessions", "archived_sessions"]
+            .iter()
+            .any(|dir| path.starts_with(root.join(dir)))
+    {
+        return Err("SOURCE_SCOPE".into());
+    }
+    let named = fs::symlink_metadata(path).map_err(|_| "SOURCE_ACCESS")?;
+    let owner = fs::metadata(root).map_err(|_| "SOURCE_ACCESS")?.uid();
+    if !named.is_file() || named.nlink() != 1 || named.uid() != owner || named.mode() & 0o022 != 0 {
+        return Err("SOURCE_PERMISSIONS".into());
+    }
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(DARWIN_O_NOFOLLOW)
+        .open(path)
+        .map_err(|_| "SOURCE_ACCESS")?;
+    let opened = file.metadata().map_err(|_| "SOURCE_ACCESS")?;
+    if identity(&opened) != identity(&named) {
+        return Err("SOURCE_CHANGED".into());
+    }
+    Ok((file, identity(&opened)))
+}
+fn window(
+    root: &Path,
+    path: PathBuf,
+    limit: Option<HistoryPosition>,
+    budget: &mut Budget,
+) -> Result<Window, String> {
+    budget.check()?;
+    if path.extension().is_none_or(|ext| ext != "jsonl") {
+        return Err("SOURCE_COMPRESSION_UNSUPPORTED".into());
+    }
+    let (file, identity) = secure_file(root, &path)?;
+    let mut head = Vec::new();
+    BufReader::new(file.try_clone().map_err(|_| "SOURCE_ACCESS")?)
+        .take(RECORD_BYTES as u64)
+        .read_until(b'\n', &mut head)
+        .map_err(|_| "SOURCE_ACCESS")?;
+    if head.last() != Some(&b'\n') {
+        return Err("SOURCE_RECORD_LIMIT".into());
+    }
+    budget.bytes += head.len();
+    if budget.bytes >= SCAN_BYTES {
+        return Err("SOURCE_SCAN_LIMIT".into());
+    }
+    let decoded = codex_rollout::parse_rollout_line_bytes(&head).map_err(|_| "SOURCE_SCHEMA")?;
+    let RolloutItem::SessionMeta(meta) = decoded.item else {
+        return Err("SOURCE_SCHEMA".into());
+    };
+    if decoded.ordinal
+        != Some(
+            meta.meta
+                .history_base
+                .map_or(0, |base| base.end_ordinal_exclusive),
+        )
+    {
+        return Err("SOURCE_ORDINAL".into());
+    }
+    if meta.meta.history_mode != ThreadHistoryMode::Paginated {
+        return Err("SOURCE_SCHEMA".into());
+    }
+    if meta
+        .meta
+        .dynamic_tools
+        .as_ref()
+        .is_some_and(|v| !v.is_empty())
+        || !meta.meta.selected_capability_roots.is_empty()
+    {
+        return Err("SOURCE_CAPABILITIES".into());
+    }
+    let name = path
+        .file_name()
+        .and_then(|s| s.to_str())
+        .ok_or("SOURCE_SCOPE")?;
+    let ids = name
+        .strip_prefix("rollout-")
+        .and_then(|s| s.get(20..))
+        .and_then(|s| s.strip_suffix(".jsonl"))
+        .ok_or("SOURCE_SCOPE")?;
+    let (logical, physical) = ids.split_once('_').unwrap_or((ids, ids));
+    if logical != meta.meta.id.to_string() {
+        return Err("SOURCE_IDENTITY".into());
+    }
+    let rollout_id = ThreadId::from_string(physical).map_err(|_| "SOURCE_SCOPE")?;
+    let size = file.metadata().map_err(|_| "SOURCE_ACCESS")?.len();
+    let end = limit.map_or(size, |p| p.end_byte_offset);
+    if end > size || limit.is_some_and(|p| p.thread_id != rollout_id) {
+        return Err("SOURCE_CHANGED".into());
+    }
+    let length =
+        usize::try_from(end.min((SCAN_BYTES - budget.bytes) as u64)).map_err(|_| "SOURCE_LIMIT")?;
+    if length == 0 {
+        return Err("SOURCE_LIMIT".into());
+    }
+    let mut start = end - length as u64;
+    let mut bytes = vec![0; length];
+    for (index, block) in bytes.chunks_mut(64 * 1024).enumerate() {
+        budget.check()?;
+        file.read_exact_at(block, start + (index * 64 * 1024) as u64)
+            .map_err(|_| "SOURCE_CHANGED")?;
+    }
+    budget.bytes += length;
+    // A currently written record is not a committed boundary. Inherited cutoffs must be exact.
+    let last = bytes
+        .iter()
+        .rposition(|b| *b == b'\n')
+        .ok_or("SOURCE_RECORD_LIMIT")?
+        + 1;
+    if limit.is_some() && last != bytes.len() {
+        return Err("SOURCE_BOUNDARY".into());
+    }
+    bytes.truncate(last);
+    if start > 0 {
+        let skip = bytes
+            .iter()
+            .position(|b| *b == b'\n')
+            .ok_or("SOURCE_RECORD_LIMIT")?
+            + 1;
+        bytes.drain(..skip);
+        start += skip as u64;
+    }
+    Ok(Window {
+        file,
+        path,
+        identity,
+        start,
+        bytes,
+        head,
+        meta,
+        rollout_id,
+    })
+}
+fn find_ancestor(root: &Path, id: ThreadId, budget: &Budget) -> Result<PathBuf, String> {
+    let mut dirs = vec![root.join("sessions"), root.join("archived_sessions")];
+    let mut seen = 0;
+    let mut found = None;
+    while let Some(dir) = dirs.pop() {
+        budget.check()?;
+        let entries = match fs::read_dir(dir) {
+            Ok(entries) => entries,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(_) => return Err("SOURCE_ACCESS".into()),
+        };
+        for entry in entries {
+            seen += 1;
+            if seen > 50_000 {
+                return Err("SOURCE_LOOKUP_LIMIT".into());
+            }
+            let entry = entry.map_err(|_| "SOURCE_ACCESS")?;
+            let kind = entry.file_type().map_err(|_| "SOURCE_ACCESS")?;
+            if kind.is_dir() {
+                dirs.push(entry.path());
+            } else if kind.is_file()
+                && entry.file_name().to_str().is_some_and(|name| {
+                    name.ends_with(&format!("-{id}.jsonl"))
+                        || name.ends_with(&format!("_{id}.jsonl"))
+                })
+            {
+                if found.is_some() {
+                    return Err("SOURCE_AMBIGUOUS".into());
+                }
+                found = Some(entry.path());
+            }
+        }
+    }
+    found.ok_or_else(|| "SOURCE_MISSING_ANCESTOR".into())
+}
+fn read(
+    selector: ReadOnlyForkSourceParams,
+    path: PathBuf,
+    thread_id: ThreadId,
+    cancelled: Arc<AtomicBool>,
+) -> Result<ReadOnlyPrepared, String> {
+    let root = selector.source_home.as_path();
+    if fs::canonicalize(root).map_err(|_| "SOURCE_ACCESS")? != root {
+        return Err("SOURCE_SCOPE".into());
+    }
+    let root_meta = fs::metadata(root).map_err(|_| "SOURCE_ACCESS")?;
+    if !root_meta.is_dir() || root_meta.mode() & 0o022 != 0 {
+        return Err("SOURCE_PERMISSIONS".into());
+    }
+    let mut budget = Budget {
+        start: Instant::now(),
+        cancelled,
+        bytes: 0,
+        records: 0,
+        context: 0,
+    };
+    let first = window(root, path, /*limit*/ None, &mut budget)?;
+    if first.identity != selector.source_identity || first.meta.meta.id != thread_id {
+        return Err("SOURCE_CHANGED".into());
+    }
+    let canonical = first.meta.clone();
+    let source_path = first.path.clone();
+    let mut windows = Vec::new();
+    let mut current = first;
+    let mut seen = HashSet::new();
+    let mut scan = ModelContextScan::default();
+    let mut boundary = None;
+    let mut complete = false;
+    let mut expected_ordinal = None;
+    let mut selected_end = None;
+    let mut context_at = None;
+    let mut terminal = None;
+    loop {
+        if !seen.insert(current.rollout_id) || seen.len() > SOURCE_FILES {
+            return Err("SOURCE_LINEAGE_LIMIT".into());
+        }
+        let mut cursor = ReverseJsonlScanner::new(Cursor::new(current.bytes.as_slice()))
+            .map_err(|_| "SOURCE_SCHEMA")?;
+        let mut record_end = current.start + current.bytes.len() as u64;
+        while let Some(outcome) = cursor
+            .scan_next_rollout_line()
+            .map_err(|_| "SOURCE_SCHEMA")?
+        {
+            budget.check()?;
+            budget.records += 1;
+            if budget.records > RECORDS {
+                return Err("SOURCE_RECORD_LIMIT".into());
+            }
+            let ScanOutcome::Parsed(line) = outcome else {
+                return Err("SOURCE_SCHEMA".into());
+            };
+            let byte_start = current.start + cursor.position();
+            if record_end.saturating_sub(byte_start) > RECORD_BYTES as u64 {
+                return Err("SOURCE_RECORD_LIMIT".into());
+            }
+            let ordinal = line.ordinal.ok_or("SOURCE_SCHEMA")?;
+            if matches!(line.item, RolloutItem::SessionMeta(_)) {
+                if current.start != 0
+                    || record_end != current.head.len() as u64
+                    || ordinal
+                        != current
+                            .meta
+                            .meta
+                            .history_base
+                            .map_or(0, |base| base.end_ordinal_exclusive)
+                    || expected_ordinal.is_some_and(|expected| ordinal != expected)
+                {
+                    return Err("SOURCE_ORDINAL".into());
+                }
+                expected_ordinal = Some(ordinal);
+                break;
+            }
+            if expected_ordinal.is_some_and(|expected| ordinal != expected) {
+                return Err("SOURCE_ORDINAL".into());
+            }
+            expected_ordinal = ordinal.checked_sub(1);
+            if boundary.is_none()
+                && let RolloutItem::EventMsg(EventMsg::TurnComplete(event)) = &line.item
+                && event.error.is_none()
+            {
+                ThreadId::from_string(&event.turn_id).map_err(|_| "SOURCE_BOUNDARY")?;
+                boundary = Some(HistoryPosition {
+                    thread_id: current.rollout_id,
+                    end_ordinal_exclusive: ordinal.checked_add(1).ok_or("SOURCE_BOUNDARY")?,
+                    end_byte_offset: record_end,
+                });
+                context_at = Some(
+                    event.completed_at.unwrap_or(
+                        DateTime::parse_from_rfc3339(&line.timestamp)
+                            .map_err(|_| "SOURCE_SCHEMA")?
+                            .timestamp(),
+                    ),
+                );
+                terminal = Some(event.turn_id.clone());
+                selected_end = Some(record_end);
+            }
+            if boundary.is_some() {
+                budget.context += serde_json::to_vec(&line.item)
+                    .map_err(|_| "SOURCE_SCHEMA")?
+                    .len();
+                if budget.context > CONTEXT_BYTES {
+                    return Err("SOURCE_CONTEXT_LIMIT".into());
+                }
+                if scan.push(line.item) == ModelContextScanProgress::Complete {
+                    complete = true;
+                    break;
+                }
+            }
+            record_end = byte_start + 1;
+        }
+        if current.start > 0 && !complete {
+            return Err("SOURCE_SCAN_LIMIT".into());
+        }
+        let base = current.meta.meta.history_base;
+        windows.push(current);
+        if complete || base.is_none() {
+            break;
+        }
+        let base = base.ok_or("SOURCE_BOUNDARY")?;
+        if expected_ordinal != Some(base.end_ordinal_exclusive) {
+            return Err("SOURCE_ORDINAL".into());
+        }
+        expected_ordinal = base.end_ordinal_exclusive.checked_sub(1);
+        current = window(
+            root,
+            find_ancestor(root, base.thread_id, &budget)?,
+            Some(base),
+            &mut budget,
+        )?;
+    }
+    let position = boundary.ok_or("SOURCE_NO_COMPLETED_TURN")?;
+    let mut items = scan.finish(canonical.clone());
+    if !matches!(items.first(), Some(RolloutItem::SessionMeta(_))) {
+        items.insert(0, RolloutItem::SessionMeta(canonical.clone()));
+    }
+    // Validate the bytes actually read, not the changing whole user store. Appends are allowed.
+    let mut digest = Sha256::new();
+    for window in &windows {
+        budget.check()?;
+        let (_, current_identity) = secure_file(root, &window.path)?;
+        if current_identity != window.identity {
+            return Err("SOURCE_CHANGED".into());
+        }
+        let mut header = vec![0; window.head.len()];
+        window
+            .file
+            .read_exact_at(&mut header, 0)
+            .map_err(|_| "SOURCE_CHANGED")?;
+        if header != window.head {
+            return Err("SOURCE_CHANGED".into());
+        }
+        digest.update(&header);
+        let mut block = vec![0; 64 * 1024];
+        for (index, expected) in window.bytes.chunks(block.len()).enumerate() {
+            budget.check()?;
+            window
+                .file
+                .read_exact_at(
+                    &mut block[..expected.len()],
+                    window.start + (index * 64 * 1024) as u64,
+                )
+                .map_err(|_| "SOURCE_CHANGED")?;
+            if expected != &block[..expected.len()] {
+                return Err("SOURCE_CHANGED".into());
+            }
+        }
+        digest.update(window.identity.as_bytes());
+        digest.update(window.start.to_le_bytes());
+        digest.update(&window.bytes);
+    }
+    let snapshot = ReadOnlyForkSnapshot {
+        terminal_turn_id: terminal.ok_or("SOURCE_BOUNDARY")?,
+        context_at: context_at.ok_or("SOURCE_BOUNDARY")?,
+        source_identity: selector.source_identity,
+        snapshot_sha256: format!("{:x}", digest.finalize()),
+        end_ordinal_exclusive: position.end_ordinal_exclusive,
+        end_byte_offset: selected_end.ok_or("SOURCE_BOUNDARY")?,
+        source_files: windows.len() as u32,
+        scanned_bytes: budget.bytes as u64,
+        context_bytes: budget.context as u64,
+    };
+    let source = stored_source(canonical, source_path)?;
+    Ok(ReadOnlyPrepared {
+        source,
+        prepared: PreparedFork::new(thread_id, Some(position), Arc::new(items), ()),
+        snapshot,
+    })
+}
+fn stored_source(meta: SessionMetaLine, path: PathBuf) -> Result<StoredThread, String> {
+    let at = DateTime::parse_from_rfc3339(&meta.meta.timestamp)
+        .map_err(|_| "SOURCE_SCHEMA")?
+        .with_timezone(&Utc);
+    Ok(StoredThread {
+        thread_id: meta.meta.id,
+        extra_config: None,
+        rollout_path: Some(path),
+        forked_from_id: meta.meta.forked_from_id,
+        parent_thread_id: meta.meta.parent_thread_id,
+        preview: String::new(),
+        name: None,
+        model_provider: meta.meta.model_provider.unwrap_or_else(|| "openai".into()),
+        model: None,
+        reasoning_effort: None,
+        created_at: at,
+        updated_at: at,
+        recency_at: at,
+        archived_at: None,
+        section: None,
+        section_position: None,
+        section_entered_at: None,
+        project_id: None,
+        daybreak_enabled: None,
+        cwd: meta.meta.cwd,
+        cli_version: meta.meta.cli_version,
+        originator: Some(meta.meta.originator),
+        source: meta.meta.source,
+        history_mode: meta.meta.history_mode,
+        thread_source: meta.meta.thread_source,
+        agent_nickname: meta.meta.agent_nickname,
+        agent_role: meta.meta.agent_role,
+        agent_path: meta.meta.agent_path,
+        git_info: meta.git,
+        approval_mode: AskForApproval::Never,
+        permission_profile: PermissionProfile::read_only(),
+        token_usage: None,
+        first_user_message: None,
+        history: None,
+    })
+}
