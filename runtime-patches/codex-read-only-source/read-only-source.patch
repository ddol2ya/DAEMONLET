+    );
+    fs::set_permissions(&f.path, fs::Permissions::from_mode(0o666)).unwrap();
+    assert_eq!(f.run().err().unwrap(), "SOURCE_PERMISSIONS");
+    fs::set_permissions(&f.path, fs::Permissions::from_mode(0o600)).unwrap();
+    let target = f.path.with_extension("saved");
+    fs::rename(&f.path, &target).unwrap();
+    symlink(target, &f.path).unwrap();
+    assert_eq!(f.run().err().unwrap(), "SOURCE_SCOPE");
+}
+
+#[test]
+fn source_capabilities_fail_before_context_preparation() {
+    let f = Fixture::new();
+    let mut header = f.header(None);
+    header["payload"]["dynamic_tools"] = json!([{"type":"function","name":"hostile","description":"fixture","inputSchema":{"type":"object"}}]);
+    f.write(vec![header, f.complete(1)]);
+    assert_eq!(f.run().err().unwrap(), "SOURCE_CAPABILITIES");
+}
+
+#[test]
+fn invalid_lineage_cutoff_missing_ancestors_and_oversized_records_are_bounded() {
+    let f = Fixture::new();
+    let base = HistoryPosition {
+        thread_id: f.id,
+        end_ordinal_exclusive: 3,
+        end_byte_offset: 1,
+    };
+    f.write(vec![f.header(Some(base)), f.complete(4)]);
+    assert_eq!(f.run().err().unwrap(), "SOURCE_RECORD_LIMIT");
+    let missing = HistoryPosition {
+        thread_id: ThreadId::new(),
+        ..base
+    };
+    f.write(vec![f.header(Some(missing)), f.complete(4)]);
+    assert_eq!(f.run().err().unwrap(), "SOURCE_MISSING_ANCESTOR");
+    f.write(vec![
+        f.header(None),
+        marker(1, &"x".repeat(RECORD_BYTES)),
+        f.complete(2),
+    ]);
+    assert_eq!(f.run().err().unwrap(), "SOURCE_RECORD_LIMIT");
+}
+
+#[test]
+fn prepared_history_is_owned_after_source_deletion() {
+    let f = Fixture::new();
+    f.write(vec![
+        f.header(None),
+        marker(1, "OWNED_SNAPSHOT"),
+        f.complete(2),
+    ]);
+    let result = f.run().unwrap();
+    fs::remove_file(&f.path).unwrap();
+    assert!(
+        serde_json::to_string(&result.prepared.model_context)
+            .unwrap()
+            .contains("OWNED_SNAPSHOT")
+    );
+}
