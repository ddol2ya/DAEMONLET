+#[test]
+fn native_lineage_header_ordinal_is_inherited_boundary() {
+    let f = Fixture::new();
+    f.write(vec![f.header(None), marker(1, "ANCESTOR"), f.complete(2)]);
+    let ancestor = f.path.with_file_name(format!(
+        "rollout-2026-09-16T00-00-00-{}.jsonl",
+        ThreadId::new()
+    ));
+    // A different physical rollout of the same logical thread, as used by revert.
+    let physical = ThreadId::new();
+    let ancestor = ancestor.with_file_name(format!(
+        "rollout-2026-09-16T00-00-00-{}_{physical}.jsonl",
+        f.id
+    ));
+    fs::rename(&f.path, &ancestor).unwrap();
+    let base = HistoryPosition {
+        thread_id: physical,
+        end_ordinal_exclusive: 3,
+        end_byte_offset: fs::metadata(&ancestor).unwrap().len(),
+    };
+    f.write(vec![
+        f.header(Some(base)),
+        marker(4, "CHILD"),
+        f.complete(5),
+    ]);
+    let result = f.run().unwrap();
+    assert_eq!(result.snapshot.source_files, 2);
+    let history = serde_json::to_string(&result.prepared.model_context).unwrap();
+    assert!(history.find("ANCESTOR").unwrap() < history.find("CHILD").unwrap());
+    assert_eq!(
+        result
+            .prepared
+            .model_context
+            .iter()
+            .filter(|i| matches!(i, RolloutItem::SessionMeta(_)))
+            .count(),
+        1
+    );
+}
